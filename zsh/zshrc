export PATH="/Applications/CMake.app/Contents/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"

if [ -x "$HOME/.local/bin/agent" ]; then
  eval "$("$HOME/.local/bin/agent" shell-integration zsh)"
fi

# OpenClaw Completion (optional)
if [ -f "$HOME/.openclaw/completions/openclaw.zsh" ]; then
  if (( $+functions[compdef] )); then
    source "$HOME/.openclaw/completions/openclaw.zsh"
  fi
fi

# Host-local overrides (secrets, machine-specific paths, aliases)
if [ -f "$HOME/.machine.local" ]; then
  source "$HOME/.machine.local"
fi

# OpenClaw Completion
source "/Users/brian/.openclaw/completions/openclaw.zsh"
